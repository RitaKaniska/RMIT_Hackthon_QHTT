# Copy to .env and fill in values that apply to this machine.
# These are configuration knobs, not credentials.

# Browser origin registered in TideCloak. No trailing slash.
APP_ORIGIN=http://localhost:5137

# Access-token audience: the app client id. Tide ORKs will not sign a custom audience.
EMBARGO_AUDIENCE=embargo-web

# Adapter downloaded from the TideCloak console. Keep it OUT of public/.
TIDE_ADAPTER_PATH=config/tidecloak.json

# Optional extra origins allowed to frame/connect for Tide enclave re-homing.
# Comma-separated bare http(s) origins. Leave empty unless Tide support requires it.
TIDE_CSP_ORIGINS=

# SQLite file. Runtime data is gitignored.
EMBARGO_DB_PATH=data/embargo.sqlite

# The API must stay on loopback.
EMBARGO_API_HOST=127.0.0.1
EMBARGO_API_PORT=3001
