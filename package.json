{
  "name": "embargo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "migrate": "node --env-file-if-exists=.env server/migrate.mjs",
    "tide:up": "docker compose up -d tidecloak",
    "tide:provision": "ADAPTER_OUTPUT_PATH=\"$PWD/config/tidecloak.json\" bash scripts/tide/tcinit.sh"
  },
  "dependencies": {
    "@tidecloak/js": "0.14.34",
    "@tidecloak/react": "0.14.33",
    "@tideorg/js": "0.14.29",
    "heimdall-tide": "0.14.34",
    "jose": "6.2.13",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.4"
  }
}
